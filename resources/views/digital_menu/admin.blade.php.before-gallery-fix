        '<div class="hint">' + (s.orientation === 'portrait' ? 'Portrait' : 'Landscape') + ' - ' + esc(LAY[s.layout] || s.layout) + ' - ' + s.seconds + ' s - ' + (s.layout === 'offers' ? s.offers + ' offer(s)' : s.items + ' item(s)') + '</div>' +
