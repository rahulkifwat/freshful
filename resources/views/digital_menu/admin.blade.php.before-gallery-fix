  }
  var QS = {
    board: ['Red menu board', 'Each product grows out of a red glow, then its name, label, price circle and tags appear, one product after another.', { pic: 'auto', title: 'slide', price: 'auto', desc: 'fade', flow: 'seq' }, { intro: 'streak', ambient: 'bokeh', trans: 'flash', speed: 'normal', glint: true, pass: true }],
    flour: ['KFC 3D flour puff', 'Each product bursts out of a white flour cloud with sparks, like the KFC 3D billboard.', { pic: 'auto', title: 'slide', price: 'auto', desc: 'fade', flow: 'seq' }, { intro: 'flour', ambient: 'bokeh', trans: 'zoom', speed: 'normal', glint: true, pass: false }],
    kfc: ['KFC light streak', 'A glowing light streak loops around each dish, the dish appears from a dust burst, prices roll like a counter.', { pic: 'auto', title: 'slide', price: 'roll', desc: 'fade', flow: 'seq' }, { intro: 'streak', ambient: 'bokeh', trans: 'flash', speed: 'normal', glint: true, pass: true }],
    magic: ['Particle magic', 'Each dish builds itself from thousands of its own coloured particles.', { pic: 'land', title: 'blur', price: 'roll', desc: 'fade', flow: 'seq' }, { intro: 'assemble', ambient: 'stars', trans: 'zoom', speed: 'normal', glint: true, pass: true }],
    grill: ['Fire grill', 'Sparks explode as each dish lands, embers rise in the background. Good for chicken and mutton.', { pic: 'stomp', title: 'zoom', price: 'stamp', desc: 'fade', flow: 'seq' }, { intro: 'burst', ambient: 'sparks', trans: 'flash', speed: 'quick', glint: true, pass: false }],
    sea: ['Fresh seafood', 'Cool mist and falling ice flakes, dishes appear out of soft smoke. Good for fish and prawns.', { pic: 'mat', title: 'blur', price: 'glow', desc: 'fade', flow: 'seq' }, { intro: 'smoke', ambient: 'ice', trans: 'iris', speed: 'relaxed', glint: true, pass: false }],
    hot: ['Hot and steaming', 'Steam rises behind the menu, each dish appears under a spotlight.', { pic: 'mat', title: 'sweep', price: 'pop', desc: 'fade', flow: 'seq' }, { intro: 'beam', ambient: 'steam', trans: 'fade', speed: 'normal', glint: true, pass: false }],
    stage: ['Stage show', 'Moving light rays, a spotlight pop on each dish and a shock ring.', { pic: 'spot', title: 'bounce', price: 'stamp', desc: 'slide', flow: 'seq' }, { intro: 'ring', ambient: 'rays', trans: 'blinds', speed: 'normal', glint: true, pass: true }],
    cine: ['Cinematic', 'Dish flies in, name word by word, price stamped. No extra effects.', { pic: 'fly', title: 'words', price: 'stamp', desc: 'fade', flow: 'seq' }, { intro: 'none', ambient: 'bokeh', trans: 'wipe', speed: 'normal', glint: true, pass: false }],
    calm: ['Clean and calm', 'Simple and quiet: soft rise and fade, nothing flashy.', { pic: 'rise', title: 'slide', price: 'pop', desc: 'fade', flow: 'together' }, { intro: 'none', ambient: 'none', trans: 'fade', speed: 'relaxed', glint: false, pass: false }],
    fun: ['Bouncy', 'Playful bounces, good for offers.', { pic: 'bounce', title: 'bounce', price: 'pop', desc: 'slide', flow: 'seq' }, { intro: 'burst', ambient: 'stars', trans: 'slide', speed: 'quick', glint: true, pass: false }]
  };
  var LAY = { wall: 'Menu wall (KFC)', cinema: 'Cinematic', showcase: 'Showcase', duo: 'Two cards', trio: 'Three cards', board: 'Price board', offers: 'Offers poster' };
  function stateOf(s) { if (s.status === 'off') return ['off', 'Switched off']; if (!s.published) return ['draft', 'Not published']; if (s.dirty) return ['draft', 'Live, changes not published']; return ['live', 'Live v' + s.version]; }
  function drawScreens() {
